# ExoNit environment template.
#
# Copy to `.env` (never commit the real file), replace every CHANGE_ME and every
# <placeholder>, and point the systemd units at it (EnvironmentFile=/opt/exonit/.env).
# Lines starting with `# EXONIT_...=` are optional: they show the variable and a
# neutral value, and the code falls back to its built-in default when unset.
# Values below marked "policy" are the settings the reference deployment runs with.

# =============================================================================
# Core
# =============================================================================

# Operational PostgreSQL database (tasks, candidates, stars, verdicts, ...).
EXONIT_DATABASE_URL=postgresql://exonit:CHANGE_ME@localhost:5432/exonit
# Metadata PostgreSQL database (per-TIC / per-sector light-curve index; large, ~200 GB at 15 sectors).
EXONIT_METADATA_DB_URL=postgresql://exonit:CHANGE_ME@localhost:5432/exonit_meta
# Redis: shared state for the multi-process server and the work streams.
EXONIT_REDIS_URL=redis://127.0.0.1:6379/0
# Shared secret that workers present to the server. Generate a long random string.
EXONIT_WORKER_TOKEN=CHANGE_ME
# Public URL of the server as seen by workers.
EXONIT_SERVER_URL=http://<server-ip>:8400
# Address of the server host, used when the code must build worker-facing URLs.
EXONIT_SERVER_IP=<server-ip>
# TCP port the server listens on.
EXONIT_PORT=8400
# Number of uvicorn worker processes (normally set by `run_nightly.py serve --workers N`).
# EXONIT_SERVER_WORKERS=4
# Recycle each uvicorn process after this many requests (guards against slow leaks).
# EXONIT_UVICORN_MAX_REQUESTS=20000
# Shared-state backend; `memory` forces single-process in-memory state (development only).
# EXONIT_SHARED_STATE_BACKEND=memory
# Redis connection pool size for the server.
# EXONIT_REDIS_MAX_CONNECTIONS=
# Seconds to wait for a free Redis pool connection.
# EXONIT_REDIS_POOL_TIMEOUT=
# Deployment label (free text; `home` is the default).
EXONIT_DEPLOYMENT=home
# PostgreSQL connect timeout in seconds.
# EXONIT_PG_CONNECT_TIMEOUT_S=10
# PostgreSQL statement timeout in milliseconds.
# EXONIT_PG_STATEMENT_TIMEOUT_MS=600000
# Skip the code-sync check at server start-up (leave unset in normal operation).
# EXONIT_SKIP_STARTUP_CODESYNC=0
# Test-only: PostgreSQL database used by the PG-parity tests. NEVER point it at a real database; tests truncate tables.
# EXONIT_TEST_DATABASE_URL=postgresql://exonit@localhost:5432/exonit_test
# SQLite fallback paths, used only when no EXONIT_DATABASE_URL / EXONIT_METADATA_DB_URL is set.
# EXONIT_DB_PATH=data/exonit.db
# EXONIT_SQLITE_PATH=data/metadata.sqlite
# EXONIT_METADATA_CACHE=data/metadata.sqlite

# =============================================================================
# Storage
# =============================================================================

# S3-compatible object store (MinIO or similar) holding the FITS light curves.
# Leave the credentials unset to run with the local file cache only.
# EXONIT_S3_ENDPOINT=http://<storage-host>:9000
# EXONIT_S3_ACCESS_KEY=CHANGE_ME
# EXONIT_S3_SECRET_KEY=CHANGE_ME
# Bucket that holds the FITS files.
# EXONIT_S3_FITS_BUCKET=exonit-fits
# S3 region name (MinIO ignores it).
# EXONIT_S3_REGION=us-east-1
# Maximum pooled S3 connections per process.
# EXONIT_S3_POOL=48
# Set to 1 to use real AWS S3 instead of a custom endpoint.
# EXONIT_S3_USE_AWS=0
# Directory for downloaded TESS SPOC / QLP files.
# EXONIT_TESS_CACHE_DIR=data/tess_cache
# Directory the server serves FITS files from.
# EXONIT_FITS_DIR=data/fits
# Root of the SPOC FITS cache (an NFS mount on a multi-host deployment). EXONIT_TESS_CACHE_DIR is an alias.
# Default: <project>/data/tess_cache.
# EXONIT_NFS_CACHE=<path-to-spoc-cache>
# Directory with the ONNX models (workers; defaults to worker/models).
# EXONIT_MODELS_DIR=worker/models
# Directory where reports are written.
# EXONIT_REPORTS_DIR=data/reports
# Known-host catalogue and Berger+2023 database paths used by feature builders.
# EXONIT_CATALOG=data/toi_catalog.csv
# EXONIT_BERGER_DB=data/berger2023.db
# Download-registry freshness check: fingerprint file and maximum age in hours.
# EXONIT_DOWNLOAD_REGISTRY_FINGERPRINT_FILE=data/download_registry.fingerprint
# EXONIT_DOWNLOAD_REGISTRY_MAX_STALE_HOURS=
# Server-side export row cap per request.
# EXONIT_EXPORT_ROW_CAP=50000
# Seconds to wait for MAST HTTP responses.
# EXONIT_MAST_HTTP_TIMEOUT=

# =============================================================================
# Pipeline flags (policy values of the reference deployment)
# =============================================================================

# Server-side ExoMiner Docker path: off (policy). The ONNX FFI model runs on the workers instead.
EXONIT_ENABLE_EXOMINER_AUTO=0
# ExoMiner backfill: off (policy; needs the Docker path).
EXONIT_EXOMINER_BACKFILL=0
# SPOC gate: check TESS SPOC availability before treating a TIC as FFI-only (policy: on).
EXONIT_SPOC_GATE=1
# Resolve the SPOC gate from the local index only, no live MAST calls (policy: on).
EXONIT_SPOC_GATE_OFFLINE=1
# FPP gate before the vetting verdict (policy: on).
EXONIT_FPP_GATE=1
# Verdict model version (policy: v2.1).
EXONIT_VERDICT_VERSION=v2.1
# FFI verdict model version (policy: v3_tfopwg).
EXONIT_VERDICT_FFI_VERSION=v3_tfopwg
# "Done" is tracked per (TIC, sector) in tic_sector_state (policy: on).
EXONIT_DONE_STATE=1
# Redis work streams instead of SQL polling for task hand-out (policy: on).
EXONIT_WORK_STREAMS=1
# Use the Claude API as a fallback analyser: off (policy). Needs ANTHROPIC_API_KEY.
EXONIT_USE_CLAUDE_FALLBACK=0
# Only run the LoRA explanation step for strong-tier candidates (policy: on).
EXONIT_LORA_STRONG_ONLY=1
# Extra unexplained candidates (all sectors, strong tier first) that the LoRA step explains per lot on top of
# the lot's own sector; 0 = off (the code default).
# EXONIT_LORA_BACKLOG_LIMIT=0
# Use PostgreSQL for the completeness store (policy: on).
EXONIT_COMPLETENESS_PG=1
# Refresh the metadata index at the start of each lot (policy: on).
EXONIT_METADATA_REFRESH=1
# Adopt an already-active lot at orchestrator start (policy: on).
EXONIT_LOT_ADOPT_ACTIVE=1
# Selection of TICs for a lot is paged (policy: on).
EXONIT_SELECTOR_PAGED=1
# Write the per-run TIC table (policy: off).
EXONIT_RUN_TICS_WRITE=0
# Scope of a run: `tasks` counts TICs from the tasks table (policy).
EXONIT_RUN_SCOPE=tasks
# Per-TIC scan timeout in seconds.
EXONIT_SCAN_TIMEOUT_S=1800
# Fleet autoscale between phases (scan / FPP); set 0 to disable.
# EXONIT_FLEET_AUTOSCALE=1
# Seconds to wait for the fleet to reach the target size after autoscale.
# EXONIT_FLEET_AUTOSCALE_TIMEOUT_SECONDS=300
# Seconds to wait for the post-scale fleet verification.
# EXONIT_FLEET_VERIFY_TIMEOUT=
# Quiet the access log for worker poll requests (1 = quiet).
# EXONIT_QUIET_POLL_LOGS=1
# Gap statistics: v2 implementation switch (policy: on) and cache lifetimes (seconds).
EXONIT_GAP_STATS_V2=1
# EXONIT_GAP_STATS_TTL_S=3600
# EXONIT_GAP_STATS_IDLE_TTL_S=21600
# EXONIT_CLOSED_GAP_STATS_TTL_S=86400
# Cache lifetime of the task statistics endpoint (seconds).
# EXONIT_TASK_STATS_CACHE_TTL_S=60
# Use the v2 metadata path when enqueueing (policy: on).
EXONIT_ENQUEUE_METADATA_V2=1
# Gate finalists on the FFI model score.
# EXONIT_FFI_FINALIST_GATE=0
# Phase 3 FFI/SPOC agreement threshold.
# EXONIT_PHASE3_AGREEMENT_THRESHOLD=
# Disable the verdict step entirely (1 = disabled).
# EXONIT_VERDICT_DISABLED=0
# Maximum planetary radius (Jupiter radii) before the FPP gate treats a signal as non-planetary.
# EXONIT_FPP_RP_MAX_RJUP=3.0
# Concurrency caps for server-side gates and pre-processing (empty = built-in default).
# EXONIT_FPP_GATE_MAX_CONCURRENT=
# EXONIT_SPOC_CHECK_MAX_CONCURRENT=
# EXONIT_VERDICT_MAX_CONCURRENT=
# EXONIT_PREPROCESS_MAX_CONCURRENT=
# EXONIT_EXOMINER_MAX_CONCURRENT=
# Deadline (seconds) for a single SPOC availability check.
# EXONIT_SPOC_CHECK_DEADLINE=
# Seconds a backfill may hold the queue before yielding; sweep interval for primary tasks.
# EXONIT_BACKFILL_HOLD_CEILING_S=900
# EXONIT_PRIMARY_SWEEP_INTERVAL_SECONDS=
# Orchestrator/run watchdog intervals (seconds).
# EXONIT_RUN_HEARTBEAT_STALE_SECONDS=
# EXONIT_RUN_WATCHDOG_INTERVAL_SECONDS=
# EXONIT_ORCH_SPAWN_CONFIRM_POLL_SECONDS=
# EXONIT_ORCH_SPAWN_CONFIRM_TIMEOUT_SECONDS=
# Post-process timeouts (seconds).
# EXONIT_POSTPROCESS_TIMEOUT_SECONDS=21600
# EXONIT_POSTPROCESS_FPP_TIMEOUT=
# Files used to hand pipeline state / phase timings between processes.
# EXONIT_PIPELINE_STATE_FILE=data/pipeline_state.json
# EXONIT_PHASE_TIMINGS_FILE=data/phase_timings.json
# Progress reporting from scripts to the server (set by the orchestrator).
# EXONIT_PROGRESS_URL=http://127.0.0.1:8400
# EXONIT_PROGRESS_RUN_ID=
# EXONIT_PROGRESS_PHASE=
# Sector selector overrides (set by the orchestrator).
# EXONIT_SECTOR=
# Safety guard: farmctl refuses to start workers unless this is 1 (set it only in the shell that is allowed to start the fleet).
# EXONIT_FARMCTL_ALLOW_START=0

# =============================================================================
# Worker compute backends (read on the worker host, usually via the workers.json `env` block)
# =============================================================================

# Force the BLS / transit-fit backend (cuda, opencl, metal, cpu).
# EXONIT_BLS_BACKEND=
# EXONIT_WOTAN_BACKEND=
# Use double precision in the CUDA BLS kernel.
# EXONIT_BLS_CUDA_F64=0
# Maximum points for the single-precision GPU BLS kernels (empty = built-in limit).
# EXONIT_BLS_CUDA_F32_MAX_PTS=
# EXONIT_BLS_OPENCL_F32_MAX_PTS=
# Force the injection kernel on (1) or off (0) for OpenCL / Metal; empty = auto.
# EXONIT_INJECTION_OPENCL=
# EXONIT_INJECTION_METAL=
# Force the FPP step onto Metal on macOS.
# EXONIT_FPP_FORCE_METAL=
# Comma-separated GPU backends allowed for FPP; `none` disables GPU FPP.
# EXONIT_FPP_GPU_BACKENDS=
# Counters set by the worker supervisor across self-restarts (do not set by hand).
# EXONIT_CUDA_RESTART_COUNT=0
# EXONIT_UPDATE_RESTART_COUNT=0

# =============================================================================
# Optional: Claude API (only with EXONIT_USE_CLAUDE_FALLBACK=1)
# =============================================================================

ANTHROPIC_API_KEY=

# =============================================================================
# Optional: ExoMiner Docker path (advanced; see docs/advanced/exominer-docker.md)
# =============================================================================

# Checkout of the NASA ExoMiner repository (default: <project>/extern/ExoMiner).
# EXONIT_EXOMINER_REPO=/opt/exonit-extern/ExoMiner
# Container resource limits.
# EXONIT_EXOMINER_CPU_LIMIT=2
# EXONIT_EXOMINER_MEMORY_LIMIT=4g
# Run the container as root (1) instead of the invoking user.
# EXONIT_EXOMINER_DOCKER_ROOT=
# Pre-processing models / normalisation statistics used by the native ONNX path.
# EXONIT_EXOMINER_PP_MODELS=
# EXONIT_EXOMINER_PP_NORM_STATS=
# Distribute ExoMiner work over several hosts (comma-separated list or a file).
# EXONIT_EXOMINER_WORKERS=
# EXONIT_EXOMINER_WORKERS_FILE=

# =============================================================================
# Optional: completeness compaction service (exonit-compactd)
# =============================================================================

# Batch size (rows) of one compaction batch.
# EXONIT_COMPACT_BATCH_ROWS=8000000
# Parallel workers for the local compaction fallback.
# EXONIT_COMPACT_WORKERS=4
# URL and token of the compaction HTTP service (preferred path).
# EXONIT_COMPACT_SERVICE_URL=http://<compactd-host>:8646
# EXONIT_COMPACT_SERVICE_TOKEN=CHANGE_ME
# Seconds between job-status polls of the service.
# EXONIT_COMPACT_SERVICE_POLL_INTERVAL_SECONDS=15
# SSH fallback: host that runs the compaction, optional DSN override, timeout in seconds.
# EXONIT_COMPACT_REMOTE_HOST=<user>@<compactd-host>
# EXONIT_COMPACT_REMOTE_DSN=
# Checkout of ExoNit on the remote host ($HOME is expanded by its login shell).
# EXONIT_COMPACT_REMOTE_REPO=$HOME/exonit
# EXONIT_COMPACT_REMOTE_TIMEOUT_SECONDS=7200
# Overall compaction timeout used by the post-process step (seconds).
# EXONIT_COMPLETENESS_COMPACTION_TIMEOUT_SECONDS=3600
# Settings of the compaction service process itself (/etc/default/exonit-compactd).
# EXONIT_COMPACTD_TOKEN=CHANGE_ME
# EXONIT_COMPACTD_PORT=8646
# EXONIT_COMPACTD_PG_DSN=postgresql://exonit:CHANGE_ME@localhost:5432/exonit
# EXONIT_COMPACTD_JOB_TIMEOUT_SECONDS=21600

# =============================================================================
# Optional: LoRA explanation step
# =============================================================================

# Override the command that runs the explanation step (default: the Mac fleet driver).
# Aliases: `macs` (the default), `llamacpp`, `gpuq` (manual fallback through a remote gpuq GPU queue, below).
# EXONIT_LORA_CMD=
# Manual gpuq fallback: ssh target of the GPU host, the gpuq binary, an optional NVML-compat wrapper and the
# remote script (ops/lora_via_gpuq.sh) that starts vLLM inside a gpuq slot.
# EXONIT_GPUQ_SSH_TARGET=<user>@<gpu-host>
# EXONIT_GPUQ_BIN=gpuq
# EXONIT_GPUQ_NVML_WRAPPER=
# EXONIT_GPUQ_LORA_SCRIPT=lora_via_gpuq.sh
# Name (in workers.json) of the worker that shares its GPU with the gpuq fallback; the orchestrator stops it
# before the LoRA step. Empty = nothing to stop.
# EXONIT_GPU_HOST_WORKER=
# Restrict the step to one sector (set by the orchestrator).
# EXONIT_LORA_SECTOR=
# Database the step reads candidates from.
# EXONIT_LORA_DB=
# Timeout of the whole step in seconds.
# EXONIT_LORA_TIMEOUT_SECONDS=86400
# Explainer endpoint used by scripts/generate_missing_explanations.py when neither --explainer-url nor
# --endpoints-json is given (manual runs). Default http://127.0.0.1:8500/api/explain.
# EXONIT_EXPLAINER_URL=

# =============================================================================
# Optional: autonomy supervisor
# =============================================================================

# Fleet file of the autonomy subsystem (name -> {ssh, platform}); template: ops/autonomy_fleet.example.json.
# EXONIT_AUTONOMY_FLEET=ops/autonomy_fleet.json
# Second key of the "armed" mode (the first is `armed: true` in the autonomy config). Leave 0 until you validated the runbook.
# EXONIT_AUTONOMY_ARMED=0
# Alert mail subject/body overrides (set by the alerting helper).
# EXONIT_ALERT_SUBJECT=
# EXONIT_ALERT_BODY=

# =============================================================================
# Legacy: AWS burst workers (decommissioned in the reference deployment; kept for old scripts)
# =============================================================================

# EXONIT_AWS_REGION=eu-west-1
# EXONIT_AWS_LAUNCH_TEMPLATE=
# EXONIT_AWS_SERVER_INSTANCE_ID=
# EXONIT_AWS_WORKER_TOKEN=CHANGE_ME
# EXONIT_AWS_WORKER_COUNT=12
# EXONIT_AWS_S3_PREFIX=
# EXONIT_AWS_S3_RUNS_PREFIX=
# EXONIT_AWS_EXPORT_TIMEOUT_SECONDS=7200
# EXONIT_AWS_SYNC_TIMEOUT_SECONDS=7200

# Memory allocator tuning for the server (glibc arenas).
MALLOC_ARENA_MAX=2

# Path of the py-spy binary used by scripts/restart_exonit_server.py for forensics (default: PATH, then ~/.local/bin).
# EXONIT_PYSPY_BIN=
